# Template for Render environment settings or a local Docker --env-file.
# Fill the blank values privately; never commit a populated copy.
APP_NAME=DailyWinsTracker
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=
PORT=10000

DB_CONNECTION=pgsql
# Paste only the postgresql:// connection URI from Neon, not the psql command.
DB_URL=
DB_SSLMODE=require

# Exact frontend origins separated by commas, without paths or trailing slashes.
FRONTEND_ORIGINS=
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
APP_MAINTENANCE_DRIVER=file
MAIL_MAILER=log

# Run pending migrations on start. Enable only for the intended database.
RUN_MIGRATIONS=true
# Enable for the initial demo seed, then set false and redeploy.
SEED_DEMO=false
